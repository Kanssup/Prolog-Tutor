{
  "name": "backend",
  "version": "1.0.0",
  "description": "Prolog_tutor",
  "license": "ISC",
  "author": "Misael_Vanegas",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "test": "NODE_ENV=test jest --runInBand --forceExit",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.0",
    "helmet": "^7.0.0",
    "joi": "^17.13.3",
    "lru-cache": "^10.0.0",
    "swipl-stdio": "^1.0.4",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "jest-environment-node": "^30.3.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "*.js",
      "!**/node_modules/**",
      "!**/temp/**"
    ],
    "coverageDirectory": "coverage",
    "verbose": true,
    "testTimeout": 30000,
    "forceExit": true,
    "detectOpenHandles": true
  }
}
